# OpenRouter API key — used for both chat and embeddings.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Postgres connection string for the LangGraph PostgresSaver checkpointer.
# Local dev example:
#   docker run -d --name hr-rag-pg -p 5432:5432 \
#       -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=hr_rag postgres:16
DB_URI=postgresql://postgres:postgres@localhost:5432/hr_rag?sslmode=disable
