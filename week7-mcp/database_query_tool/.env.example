# Copy to `.env` and fill in. Never commit `.env`.

# OpenRouter — used by the LangChain client to call the LLM.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_ID=openai:google/gemini-2.5-flash-lite

# Database — points at the Chinook Postgres container from docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://chinook:chinook@localhost:5433/chinook

# MCP server — host/port the FastMCP process binds to.
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_URL=http://localhost:8000/mcp
MCP_DEFAULT_LIMIT=100
MCP_MAX_LIMIT=1000
